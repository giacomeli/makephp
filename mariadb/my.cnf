[mysqld]
# Accepts connections from any Docker network IP (external exposure is
# controlled by the 127.0.0.1 binding in docker-compose.yml)
bind-address = 0.0.0.0

# Memory
innodb_buffer_pool_size = 1024M           # Raise with available memory (ideally 60-80% of the container RAM)
innodb_buffer_pool_instances = 1          # Split the buffer pool for high-load performance
innodb_log_file_size = 512M               # InnoDB log size (ideally between 128M and 1G)
innodb_log_buffer_size = 64M              # Transaction log buffer, improves I/O
innodb_flush_method = O_DIRECT            # Avoids double caching between the OS and InnoDB
innodb_flush_log_at_trx_commit = 2        # Trades strict durability for write performance
innodb_file_per_table = 1                 # One file per table, easier space reclaim

# Connections and lifetimes
max_connections = 200                     # Size according to the expected workload
wait_timeout = 28800                      # Idle connection timeout
interactive_timeout = 28800               # Same as wait_timeout for interactive connections

# Query cache (helps repeated queries)
query_cache_size = 64M                    # Disable if the workload is InnoDB-write-heavy
query_cache_type = 1                      # 1 = on demand

# Packets and caches
max_allowed_packet = 128M                 # Size for large packets; 128M is reasonable
table_open_cache = 2000                   # Number of tables kept open in cache
thread_cache_size = 50                    # Thread cache to reduce spawn overhead

# General tuning
tmp_table_size = 64M                      # Temporary table size
max_heap_table_size = 64M                 # Maximum HEAP table size
join_buffer_size = 4M                     # Join buffer, matters for complex queries
sort_buffer_size = 4M                     # Sort buffer
read_rnd_buffer_size = 4M                 # Random read buffer

# Slow query log
slow_query_log = 1
slow_query_log_file = /var/log/mysql/mariadb-slow.log
long_query_time = 1                       # Log queries slower than 1 second
