[mysqld]
# Aceita conexões de qualquer IP da rede Docker (exposição externa é
# controlada pelo bind 127.0.0.1 no docker-compose.yml)
bind-address = 0.0.0.0

# Controle de Memória
innodb_buffer_pool_size = 1024M           # Aumente conforme o total de memória disponível (idealmente 60-80% da RAM do container)
innodb_buffer_pool_instances = 1          # Divida o buffer pool para maior desempenho em alta carga
innodb_log_file_size = 512M               # Tamanho do log InnoDB (idealmente entre 128M e 1G)
innodb_log_buffer_size = 64M              # Buffer do log de transações, ajuda a melhorar o I/O
innodb_flush_method = O_DIRECT            # Minimiza a utilização de cache duplo entre SO e InnoDB
innodb_flush_log_at_trx_commit = 2        # Ajusta a consistência dos dados com menor escrita (compensa desempenho e durabilidade)
innodb_file_per_table = 1                 # Mantém os dados separados por tabela, facilitando a recuperação de espaço

# Conexões e Tempo de Vida
max_connections = 200                     # Defina conforme sua aplicação e uso esperado
wait_timeout = 28800                      # Tempo de espera de conexões inativas, recomendado manter baixo
interactive_timeout = 28800               # Igual ao `wait_timeout` para conexões interativas

# Configurações de Query Cache (Ajuda para Query Repetidas)
query_cache_size = 64M                    # Cache para consultas, desabilite se estiver usando InnoDB intensivamente
query_cache_type = 1                      # Ativa o cache de queries (1 é on demand, enquanto 2 é always)

# Controle de Pacotes e Cache
max_allowed_packet = 128M                 # Defina com base no uso de pacotes grandes, 128M é razoável
table_open_cache = 2000                   # Número de tabelas que podem ser abertas em cache
thread_cache_size = 50                    # Cache de threads para reduzir overhead de threads

# Melhorias Gerais
tmp_table_size = 64M                      # Tamanho das tabelas temporárias (ajuste conforme uso)
max_heap_table_size = 64M                 # Tamanho máximo das tabelas HEAP
join_buffer_size = 4M                     # Buffer para joins, importante em queries complexas
sort_buffer_size = 4M                     # Buffer para ordenações
read_rnd_buffer_size = 4M                 # Buffer para leitura aleatória em tabelas

# Log Slow Queries (Debug de queries lentas)
slow_query_log = 1
slow_query_log_file = /var/log/mysql/mariadb-slow.log
long_query_time = 1                       # Loga consultas que levam mais de 1 segundo