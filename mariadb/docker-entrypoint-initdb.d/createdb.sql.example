--
-- Copie este arquivo para createdb.sql (mesma pasta) e descomente/ajuste os
-- blocos abaixo para criar bancos adicionais e conceder acesso ao usuario
-- definido em MARIADB_USER no .env.
--
-- Os scripts desta pasta rodam automaticamente APENAS na primeira
-- inicializacao do volume de dados. Com o volume ja criado, execute manualmente:
--
--     docker compose exec mariadb sh -c 'mariadb -uroot -p"$MYSQL_ROOT_PASSWORD" < /docker-entrypoint-initdb.d/createdb.sql'
--
-- O banco e o usuario principais (MARIADB_DATABASE / MARIADB_USER) ja sao
-- criados pelo entrypoint oficial da imagem — aqui entram apenas extras.
--

-- CREATE DATABASE IF NOT EXISTS `app_db_1` COLLATE 'utf8mb4_general_ci';
-- GRANT ALL ON `app_db_1`.* TO 'seu_usuario'@'%';

-- CREATE DATABASE IF NOT EXISTS `app_db_2` COLLATE 'utf8mb4_general_ci';
-- GRANT ALL ON `app_db_2`.* TO 'seu_usuario'@'%';

FLUSH PRIVILEGES;
