--
-- Copy this file to createdb.sql (same folder) and uncomment/adjust the
-- blocks below to create additional databases and grant access to the user
-- defined as MARIADB_USER in .env.
--
-- Scripts in this folder run automatically ONLY on the first initialization
-- of the data volume. With an existing volume, run manually:
--
--     docker compose exec mariadb sh -c 'mariadb -uroot -p"$MYSQL_ROOT_PASSWORD" < /docker-entrypoint-initdb.d/createdb.sql'
--
-- The primary database and user (MARIADB_DATABASE / MARIADB_USER) are
-- already created by the official image entrypoint — only extras go here.
--

-- CREATE DATABASE IF NOT EXISTS `app_db_1` COLLATE 'utf8mb4_general_ci';
-- GRANT ALL ON `app_db_1`.* TO 'your_user'@'%';

-- CREATE DATABASE IF NOT EXISTS `app_db_2` COLLATE 'utf8mb4_general_ci';
-- GRANT ALL ON `app_db_2`.* TO 'your_user'@'%';

FLUSH PRIVILEGES;
