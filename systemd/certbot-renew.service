[Unit]
Description=Renew Let's Encrypt certificates (certbot in Docker) and reload nginx
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
# Adjust User and the three paths below for your host before installing
User=debian
Environment=PHPDOCKER_DIR=/home/debian/Projects/phpdocker
WorkingDirectory=/home/debian/Projects/phpdocker
ExecStart=/home/debian/Projects/phpdocker/scripts/cert-renew.sh
