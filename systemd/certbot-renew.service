[Unit]
Description=Renova certificados Let's Encrypt (certbot em Docker) e recarrega nginx
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
# Ajuste User e os dois paths abaixo para o seu host antes de instalar
User=debian
Environment=PHPDOCKER_DIR=/home/debian/Projects/phpdocker
WorkingDirectory=/home/debian/Projects/phpdocker
ExecStart=/home/debian/Projects/phpdocker/scripts/cert-renew.sh
