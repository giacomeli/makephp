# ============================================================
# makephp — central configuration
# Copy to .env (make init does it) and adjust the values.
# Every "changeme" password MUST be replaced before real use.
# ============================================================

# Base
ENVIRONMENT=staging                       # staging | production
TZ=UTC
LOCAL_DIR=/absolute/path/to/your/projects # host folder mounted at DOCKER_PROJECT_PATH
DOCKER_PROJECT_PATH=/var/www
APP_CONTAINER_CFG_DIR=container_config    # container config folder inside each app

# Compose: base file + apps registered via make register-app
COMPOSE_FILE=docker-compose.yml:compose.apps.yml

# DockerHub (make push-php)
DOCKERHUB_USER=giacomeli

# PHP base
PHP_CONTAINER_NAME=makephp-php
PHP_IMAGE_TAG=8.3-dev
PHP_ALIASES="makephp-php makephp-workspace"
PHP_ENABLE_SWOOLE=true
PHP_ENABLE_XDEBUG=false                   # true installs Xdebug in the dev image build
XDEBUG_ENABLE=off                         # Xdebug runtime mode (off|debug|develop) — requires PHP_ENABLE_XDEBUG=true

# Nginx
NGINX_CONTAINER_NAME=makephp-nginx
NGINX_PORT_HTTP=8099                      # 80 in production
NGINX_PORT_HTTPS=443
NGINX_ALIASES="makephp-nginx"

# Certbot / Let's Encrypt
CERTBOT_EMAIL=
CERTBOT_STAGING=1                         # 1 = Let's Encrypt staging environment (use while testing)

# MariaDB
MARIADB_CONTAINER_NAME=makephp-mariadb
MARIADB_PORT=3306
MARIADB_ROOT_PASSWORD=changeme
MARIADB_DATABASE=makephp
MARIADB_USER=makephp
MARIADB_PASSWORD=changeme
MARIADB_ALIASES=makephp-mariadb

# PostgreSQL + TimescaleDB
POSTGRES_TIMESCALE_CONTAINER_NAME=makephp-postgres
POSTGRES_TIMESCALE_PORT=5432
POSTGRES_TIMESCALE_DATABASE=makephp
POSTGRES_TIMESCALE_USER=makephp
POSTGRES_TIMESCALE_PASSWORD=changeme
POSTGRES_TIMESCALE_ALIASES=makephp-postgres

# Redis
REDIS_CONTAINER_NAME=makephp-redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme
REDIS_ALIASES=makephp-redis

# RabbitMQ
RABBITMQ_CONTAINER_NAME=makephp-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=makephp
RABBITMQ_PASSWORD=changeme
RABBITMQ_ALIASES=makephp-rabbitmq

# MongoDB (not started by the default make up — use make up mongodb)
MONGODB_CONTAINER_NAME=makephp-mongodb
MONGODB_PORT=27017
MONGODB_ROOT_USERNAME=root
MONGODB_ROOT_PASSWORD=changeme
MONGODB_DATABASE=makephp
MONGODB_ALIASES=makephp-mongodb

# ------------------------------------------------------------
# Apps — one <APP>_* block per application.
# After filling it in: make register-app <app> && make build-app <app>
# ------------------------------------------------------------

# Example app shipped with the repository (examples/demo-app)
DEMO_APP_NGINX_MODE=proxy                 # php | proxy | html | none
DEMO_APP_CONTAINER_NAME=demo-app
DEMO_APP_PROJECT_PATH=./examples/demo-app
DEMO_APP_DOCKER_PATH=/var/www
DEMO_APP_ALIASES="demo-app.test"
DEMO_APP_PORT=8000
